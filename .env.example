# Database
DATABASE_URL="postgresql://bayup:bayup@localhost:5433/bayup?schema=public"

# Auth
# Required. Generate a real, unique value — e.g. `npx auth secret` or
# `openssl rand -base64 32` — and never commit the real value. The app
# refuses to start in production without one (see src/lib/auth.ts).
AUTH_SECRET=

# Payments
# "mock" is the only working provider today. Switching to "tribute" requires
# implementing src/lib/payments/providers/TributePaymentProvider.ts first.
PAYMENT_PROVIDER=mock

# Tribute API (placeholder only — do not fill in until Tribute docs/credentials are provided)
TRIBUTE_API_URL=
TRIBUTE_API_KEY=
TRIBUTE_WEBHOOK_SECRET=

# Public app URL, used to build absolute payment redirect URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
